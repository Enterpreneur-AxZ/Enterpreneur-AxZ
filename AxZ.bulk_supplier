    window.addToCart = function(id) {  
      if (state.profile.role !== 'customer') return;  
      const mat = state.materials.find(m => m.id === id);  
      if (!mat) return;  
        
      const selElement = document.getElementById(`var-sel-${id}`);  
      const vIdx = selElement.value !== undefined ? selElement.value : selElement.dataset.value;  
      const variant = mat.variants[vIdx];  
        
      const qty = parseInt(document.getElementById(`qty-${id}`).value) || 1;  
      const available = Number(variant.stock);  
        
      if (qty > available) {  
        return window.showToast(`Only ${available} available in stock.`, "error");  
      }  
  
      const unitPrice = getVariantPrice(variant);  
      const existing = state.cart.find(c => c.id === id && c.variantIdx === vIdx);  
  
      if (existing) {  
        const newQty = existing.quantity + qty;  
        if(newQty > available) {  
           window.showToast(`Cannot exceed stock limit (${available}).`, "error");  
        } else {  
           existing.quantity = newQty;  
           window.showToast(`Updated quantity in quote`);  
        }  
      } else {  
        state.cart.push({  
            id: mat.id, name: mat.name, variantIdx: vIdx,  
            spec: variant.spec, unit: variant.unit,  
            price: unitPrice, quantity: qty  
        });  
        window.showToast("Added to quote cart");  
      }  
        
      updateCartBadge();  
      if(!document.getElementById('quoteDrawerOverlay').classList.contains('hidden')) renderCartDrawer();  
    };  
  
