        const d = new Date(c.createdAt).toLocaleDateString();  
        const t = c.tier || 'Base';  
        const emailDisp = c.email ? `<div class="text-[10px] text-slate-500 font-normal mt-0.5">${c.email}</div>` : '';  
        return `  
          <tr class="hover:bg-slate-950 transition border-b border-slate-800/50">  
            <td class="p-4"><div class="font-bold text-white">${c.name}</div>${emailDisp}</td>  
            <td class="p-4 text-xs font-semibold text-slate-400 capitalize">${c.role}</td>  
            <td class="p-4 text-xs text-slate-400">${d}</td>  
            <td class="p-4">  
               <select onchange="window.updateUserTier('${c.uid}', this.value)" class="bg-slate-900 border border-amber-500/50 rounded-lg p-2 text-xs font-bold text-amber-400 focus:outline-none focus:border-amber-400 cursor-pointer">  
                  <option value="Base" ${t === 'Base' ? 'selected' : ''}>Base (Individual)</option>  
                  <option value="Moderate" ${t === 'Moderate' ? 'selected' : ''}>Moderate (Contractor)</option>  
                  <option value="Construction" ${t === 'Construction' ? 'selected' : ''}>Construction (Business)</option>  
               </select>  
            </td>  
          </tr>  
        `;  
      }).join('');  
    }  
  
    window.updateUserTier = async function(uid, newTier) {  
      if (!state.user || state.profile.role !== 'owner') return;  
      try {  
        await updateDoc(getPublicDoc('profiles', uid), { tier: newTier });  
        window.showToast("User tier updated successfully.");  
      } catch (e) { window.showToast("Failed to update tier", "error"); }  
    };  
  
    function renderSettingsCategories() {  
      const container = document.getElementById('adminSettingsCategories');  
      if(!container) return;  
      container.innerHTML = state.customCategories.map((cat, idx) => `  
        <div class="flex justify-between items-center bg-slate-900 border border-slate-700 p-3 rounded-lg group">  
           <span class="text-sm font-bold text-slate-200">${cat}</span>  
           <button onclick="window.removeCategorySetting(${idx})" class="text-rose-500 hover:bg-rose-500/10 p-1.5 rounded opacity-0 group-hover:opacity-100 transition" title="Remove">  
              <i data-lucide="trash-2" class="w-4 h-4"></i>  
           </button>  
        </div>  
      `).join('');  
      lucide.createIcons({ root: container });  
    }  
  
    window.addCategorySetting = function() {  
      const input = document.getElementById('newCategoryInput'); const val = input.value.trim();  
      if(!val) return;  
      if(state.customCategories.includes(val)) return window.showToast("Category exists", "error");  
      state.customCategories.push(val); input.value = ''; renderSettingsCategories();  
    };  
    window.removeCategorySetting = function(idx) { state.customCategories.splice(idx, 1); renderSettingsCategories(); };  
    window.saveStoreSettings = async function() {  
      if (!state.user || state.profile.role !== 'owner') return;  
      try {  
        await setDoc(getPublicDoc('settings', 'general'), { categories: state.customCategories, updatedAt: new Date().toISOString() });  
        window.showToast("Categories saved globally!");  
      } catch (e) { window.showToast("Failed to save settings", "error"); }  
    };  
    function updateProductEditorCategories() {  
      const sel = document.getElementById('editProductCategory'); if(!sel) return;  
      sel.innerHTML = state.customCategories.map(c => `<option value="${c}">${c}</option>`).join('');  
    }  
  
    // POS Calculator  
    window.updatePosCalcOptions = function() {  
        const matSelect = document.getElementById('posCalcMaterial');  
        const varSelect = document.getElementById('posCalcVariant');  
        const tierSelect = document.getElementById('posCalcTier');  
          
        if (!matSelect || !varSelect || !tierSelect) return;  
        const tier = tierSelect.value;  
        document.getElementById('posCalcCurrentTier').textContent = tier;  
  
        const prevMatVal = matSelect.value;  
        matSelect.innerHTML = state.materials.map(m => `<option value="${m.id}">${m.name}</option>`).join('');  
        if(prevMatVal && state.materials.find(m => m.id === prevMatVal)) matSelect.value = prevMatVal;  
  
        const selectedMat = state.materials.find(m => m.id === matSelect.value);  
        if (selectedMat && selectedMat.variants) {  
            varSelect.innerHTML = selectedMat.variants.map((v, idx) => {  
                let p = tier === 'Construction' ? v.priceConstruction : tier === 'Moderate' ? v.priceModerate : v.priceBase;  
                return `<option value="${idx}">${v.spec} (${v.unit}) - ${formatINR(p)}</option>`;  
            }).join('');  
        } else { varSelect.innerHTML = ''; }  
    };  
  
    window.addPosCalcItem = function() {  
        const matId = document.getElementById('posCalcMaterial').value;  
        const vIdx = document.getElementById('posCalcVariant').value;  
        const qty = parseInt(document.getElementById('posCalcQty').value) || 1;  
        const tier = document.getElementById('posCalcTier').value;  
        if (!matId || vIdx === "") return window.showToast("Select material and variant", "error");  
  
        const mat = state.materials.find(m => m.id === matId);  
        const variant = mat.variants[vIdx];  
        const price = tier === 'Construction' ? variant.priceConstruction : tier === 'Moderate' ? variant.priceModerate : variant.priceBase;  
  
        const existing = state.posCart.find(i => i.matId === matId && i.vIdx === vIdx);  
        if(existing) { existing.qty += qty; existing.price = price; }   
        else { state.posCart.push({ matId, vIdx, qty, price, name: mat.name, spec: variant.spec, unit: variant.unit }); }  
          
        document.getElementById('posCalcQty').value = 1; renderPosCalc();  
    };  
  
    function renderPosCalc() {  
       const tbody = document.getElementById('posCalcTableBody');  
       let total = 0; let items = 0;  
       if (state.posCart.length === 0) { tbody.innerHTML = `<tr><td colspan="5" class="p-8 text-center text-slate-500 font-bold">Calculator is empty.</td></tr>`; }   
       else {  
           tbody.innerHTML = state.posCart.map((item, idx) => {  
               const lineTotal = item.qty * item.price; total += lineTotal; items += item.qty;  
               return `  
                  <tr class="border-b border-slate-800/50 hover:bg-slate-900/50 transition">  
                     <td class="p-3">  
                        <div class="font-bold text-white text-sm">${item.name}</div>  
                        <div class="text-[10px] text-amber-500 uppercase font-bold tracking-wider">${item.spec} / ${item.unit}</div>  
                     </td>  
                     <td class="p-3 text-right font-mono text-slate-300">${formatINR(item.price)}</td>  
                     <td class="p-3 text-right text-white font-bold">${item.qty}</td>  
                     <td class="p-3 text-right font-mono text-emerald-400 font-bold">${formatINR(lineTotal)}</td>  
                     <td class="p-3 text-center">  
                        <button onclick="window.removePosCalcItem(${idx})" class="p-1.5 text-rose-500 hover:bg-rose-500/10 rounded transition"><i data-lucide="x" class="w-4 h-4"></i></button>  
                     </td>  
                  </tr>`;  
           }).join('');  
       }  
       document.getElementById('posCalcTotalItems').textContent = items;  
       document.getElementById('posCalcGrandTotal').textContent = formatINR(total);  
       lucide.createIcons({ root: tbody });  
    }  
  
    window.removePosCalcItem = function(idx) { state.posCart.splice(idx, 1); renderPosCalc(); };  
    window.clearPosCalc = function() { state.posCart = []; renderPosCalc(); };  
  
    document.addEventListener('DOMContentLoaded', () => { lucide.createIcons(); });  
  </script>  </body>  
</html>  
